# Web (Next.js) variables live in web/.env.example: Next.js only reads web/.env.

# ---- Prover (script/ and server/) ----
# Proof modes: `mock` (fake proofs), `cpu` (local), `cuda` (local GPU), `network` (Succinct Prover Network).
SP1_PROVER=cpu
# Only needed when SP1_PROVER=network. Never commit a real key.
NETWORK_PRIVATE_KEY=

# ---- Server (server/) ----
# Defaults to localhost only.
ZKCERT_SERVER_ADDR=127.0.0.1:8080
RUST_LOG=info

# ---- Contracts (contracts/) ----
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
# Deployer key for testnet only. Never commit a real key.
PRIVATE_KEY=
ETHERSCAN_API_KEY=
