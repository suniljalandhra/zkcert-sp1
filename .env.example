# Web (Next.js) variables live in web/.env.example: Next.js only reads web/.env.

# ---- Prover (script/ and server/) ----
# Where proofs are made:
#   cpu      this machine (default for the demo): your email never leaves it. Off-chain (compressed)
#            proofs take about 1-2 minutes on a 16 GB Apple M4. On-chain (Groth16) proofs run out of memory.
#   network  Succinct Prover Network: needs NETWORK_PRIVATE_KEY; the email's signed headers and body are
#            sent to its provers. Needed for on-chain (Groth16) proofs on a 16 GB machine.
#   mock     instant fake proofs for UI development only (they never verify).
#   cuda     local GPU.
SP1_PROVER=cpu
# Only needed when SP1_PROVER=network. Never commit a real key.
NETWORK_PRIVATE_KEY=
# Fewer parallel workers keep local proving within 16 GB (SP1 defaults: 4 core, 8 recursion).
SP1_WORKER_NUM_CORE_WORKERS=2
SP1_WORKER_NUM_RECURSION_PROVER_WORKERS=2

# ---- Server (server/) ----
# Defaults to localhost only.
ZKCERT_SERVER_ADDR=127.0.0.1:8080
# The web UI origin allowed by CORS.
ZKCERT_CORS_ORIGIN=http://localhost:3000
RUST_LOG=info

# ---- Contracts (contracts/) ----
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
# Deployer key for testnet only. Never commit a real key.
PRIVATE_KEY=
ETHERSCAN_API_KEY=
