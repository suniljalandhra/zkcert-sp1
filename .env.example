# Web (Next.js) variables live in web/.env.example: Next.js only reads web/.env.

# ---- Prover (script/ and server/) ----
# Proof modes: `mock` (instant, no real proof: UI demo only), `network` (Succinct Prover Network; needs
# NETWORK_PRIVATE_KEY; recommended for real Groth16 proofs), `cpu` (local; the Groth16 wrap needs more than
# 16 GB RAM), `cuda` (local GPU).
SP1_PROVER=mock
# Only needed when SP1_PROVER=network. Never commit a real key.
NETWORK_PRIVATE_KEY=

# ---- Server (server/) ----
# Defaults to localhost only.
ZKCERT_SERVER_ADDR=127.0.0.1:8080
# The web UI origin allowed by CORS.
ZKCERT_CORS_ORIGIN=http://localhost:3000
RUST_LOG=info

# ---- Contracts (contracts/) ----
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
# Deployer key for testnet only. Never commit a real key.
PRIVATE_KEY=
ETHERSCAN_API_KEY=
